{
  "name": "armag",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run test && npm run check:content && astro build && npm run postbuild:index && npm run check:site && npm run check:assets",
    "build:fast": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test",
    "check:content": "node scripts/integrity/check-content.mjs",
    "check:self": "node scripts/integrity/check-self.mjs",
    "check:site": "node scripts/integrity/check-site.mjs",
    "check:assets": "node scripts/integrity/check-assets.mjs",
    "fixture:lay": "node scripts/dev/render-fixture.mjs",
    "fixture:clear": "node scripts/dev/render-fixture.mjs --remove",
    "postbuild:index": "pagefind --site dist",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.2.2",
    "svelte": "^5.56.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
