---
/**
 * Breadcrumb trail. Also the source of the `BreadcrumbList` JSON-LD on content
 * pages (SPEC.md §12), emitted here from the same array the visible trail
 * renders from, so the markup and the structured data cannot describe
 * different paths. A template that shows a trail gets the structured data for
 * it with no second call and nothing to keep in step.
 */
import JsonLd from './JsonLd.astro';
import { absoluteUrl, href } from '../../lib/content/href.ts';
import { breadcrumbList } from '../../lib/render/json-ld.ts';

export interface Crumb {
  label: string;
  /** Absent for the current page, which is not a link to itself. */
  path?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
const all: Crumb[] = [{ label: 'ARMAG', path: href() }, ...crumbs];

const node = breadcrumbList(all, (path) => absoluteUrl(Astro.site, path));
---

<JsonLd node={node} />

<nav aria-label="Breadcrumb" class="type-data text-xs text-ink-muted">
  <ol class="flex flex-wrap items-center gap-1">
    {
      all.map((crumb, index) => (
        <li class="flex items-center gap-1">
          {index > 0 && <span aria-hidden="true">/</span>}
          {crumb.path ? (
            <a href={crumb.path} class="hover:text-ui-accent">
              {crumb.label}
            </a>
          ) : (
            <span aria-current="page" class="text-ink-secondary">
              {crumb.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
