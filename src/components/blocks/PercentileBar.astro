---
/**
 * The bar next to a number — SPEC.md §8.5.
 *
 * **The bar's length is the value's percentile within a stated comparison set**,
 * and the label is the real value with its real unit. Never a normalised 0–100
 * score: game weapon screens run on invented balance numbers, and this site
 * borrows their legibility and none of their epistemology.
 *
 * The comparison set is named in the DOM, not in a tooltip, because a bar whose
 * population is unstated is exactly the unitless score §8.5 rejects.
 */
import type { PercentileResult } from '../../lib/math/percentile.ts';

interface Props {
  result: PercentileResult;
  /** Tailwind text colour class for the fill, e.g. 'bg-type-rifle'. */
  fillClass?: string;
}

const { result, fillClass = 'bg-ui-accent' } = Astro.props;
const width = Math.max(2, Math.round(result.fraction * 100));
---

<div class="mt-1">
  <div
    class="h-1 w-full overflow-hidden rounded-full bg-surface-3"
    role="img"
    aria-label={`${result.percentile}th percentile among ${result.setLabel}, out of ${result.populationSize}`}
  >
    <div class={`h-full rounded-full ${fillClass}`} style={`width: ${width}%`}></div>
  </div>
  <p class="type-data mt-1 text-[0.65rem] text-ink-muted">
    {result.percentile}th percentile among {result.setLabel} (n = {result.populationSize})
  </p>
</div>
