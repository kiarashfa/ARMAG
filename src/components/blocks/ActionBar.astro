---
/**
 * The sticky entry bar — SPEC.md §11: *"A sticky 44px bar on scroll carries the
 * entry name and four actions."*
 *
 * Three of the four are here. **Armory** lands with the collection in Phase 7,
 * and **Range** is deliberately absent rather than stubbed: `/guns/<slug>/range/`
 * is reserved for v2 (SPEC.md §9.8) and a button that 404s is worse than no
 * button.
 *
 * `position: sticky` and nothing else — no scroll listener, no island, no
 * `IntersectionObserver`. The compare control is a real link to a real URL, so
 * it works with JavaScript disabled; `CompareTray` upgrades it in place to a
 * toggle when it hydrates, which is why the identifying data is in attributes
 * rather than in a component's props.
 */
import { compareHref } from '../../lib/content/href.ts';

interface Props {
  id: string;
  name: string;
}

const { id, name } = Astro.props;
---

<div
  class="sticky top-0 z-30 -mx-(--layout-gutter) mb-2 border-b border-line bg-surface-0/95 px-(--layout-gutter) backdrop-blur"
  data-pagefind-ignore
>
  <div class="flex h-11 items-center gap-3">
    <span class="type-data min-w-0 flex-1 truncate text-sm text-ink-secondary">{name}</span>

    <a
      href={compareHref([id])}
      class="type-data shrink-0 rounded border border-line-strong bg-surface-1 px-2 py-1 text-xs text-ink-secondary no-underline hover:text-ink"
      data-compare-add={id}
      data-compare-name={name}
    >
      Compare
    </a>

    <button
      type="button"
      data-unit-toggle
      class="type-data shrink-0 rounded border border-line-strong bg-surface-1 px-2 py-1 text-xs text-ink-secondary hover:text-ink"
      aria-label="Switch between metric and imperial units"
    >
      <span class="u-metric">Metric</span><span class="u-imperial" data-pagefind-ignore>Imperial</span>
    </button>
  </div>
</div>
