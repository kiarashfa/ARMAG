---
/**
 * A glossary term — SPEC.md §5.6.
 *
 * Single-file MDX, no data twin. Every term here is auto-crosslinked from every
 * occurrence in any prose on the site by a rehype plugin (Phase 11), so link
 * density needs no manual upkeep and survives renames.
 *
 * The `assault rifle` entry states the technical definition explicitly —
 * intermediate cartridge, select fire, detachable magazine — because that page
 * will absorb a great deal of argument and the definition is the only thing
 * that ends it.
 */
import BaseLayout from '../ui/BaseLayout.astro';
import Breadcrumbs from '../blocks/Breadcrumbs.astro';
import { absoluteUrl, glossaryHref, href } from '../../lib/content/href.ts';
import { definedTerm } from '../../lib/render/json-ld.ts';

interface Props {
  /** The term's own id, for its canonical URL in the structured data. */
  id: string;
  term: string;
  short: string;
  aka: string[];
  seeAlso: { id: string; term: string }[];
}

const { id, term, short, aka, seeAlso } = Astro.props;

/** SPEC.md §12 — a glossary entry is a `DefinedTerm` in a `DefinedTermSet`. */
const jsonLd = definedTerm({
  term,
  description: short,
  url: absoluteUrl(Astro.site, glossaryHref(id)),
  aka,
  setUrl: absoluteUrl(Astro.site, href('glossary')),
});
---

<BaseLayout title={term} description={short} jsonLd={jsonLd}>
  <div data-pagefind-body class="mx-auto max-w-(--layout-max) px-(--layout-gutter) py-6">
    <Breadcrumbs crumbs={[{ label: 'Glossary', path: href('glossary') }, { label: term }]} />

    <article class="mt-4">
      <h1 class="type-display text-display text-ink">{term}</h1>
      <p class="type-body mt-3 max-w-lede text-lg text-ink-secondary">{short}</p>
      {
        aka.length > 0 && (
          <p class="type-data mt-2 text-sm text-ink-muted">Also called {aka.join(', ')}</p>
        )
      }

      {/*
        Definition and cross-references share one row on a wide screen. A
        glossary entry is a short piece of prose in a wide layout — the worst
        case for a lone reading column — and "see also" is exactly what a
        reader wants next, so it moves out from under the text and into the
        space beside it.
      */}
      <div
        class="mt-8 grid gap-(--layout-gutter) lg:grid-cols-[minmax(0,var(--measure-readable))_minmax(0,1fr)] lg:items-start"
      >
        <div class="prose type-body text-ink-secondary">
          <slot />
        </div>

        {
          seeAlso.length > 0 && (
            <nav aria-labelledby="see-also" class="lg:sticky lg:top-20">
              <p id="see-also" class="type-heading text-xs uppercase tracking-widest text-ink-muted">
                See also
              </p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {seeAlso.map((related) => (
                  <li>
                    <a
                      href={glossaryHref(related.id)}
                      class="type-data rounded border border-line px-3 py-1.5 text-sm text-ink-secondary no-underline hover:text-ui-accent"
                    >
                      {related.term}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </article>
  </div>
</BaseLayout>
