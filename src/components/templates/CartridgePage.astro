---
/**
 * The cartridge page — SPEC.md §5.4.
 *
 * **This page is also the caliber taxonomy page.** It carries real authored
 * content *and* the computed list of every arm chambered in it, which is the
 * one deliberate exception to "taxonomy pages own no content". It is what turns
 * the site's highest-traffic query class — "9mm vs .45 ACP" — into a page with
 * substance rather than an auto-generated list.
 *
 * The cartridge is also the input to every ballistic figure on every gun page
 * that chambers it, which is why its dimensions are sourced once here rather
 * than re-typed forty times.
 */
import BaseLayout from '../ui/BaseLayout.astro';
import Breadcrumbs from '../blocks/Breadcrumbs.astro';
import ImageFigure from '../blocks/ImageFigure.astro';
import Section from '../blocks/Section.astro';
import SpecRow from '../blocks/SpecRow.astro';
import SpecTable from '../blocks/SpecTable.astro';
import UnitValue from '../blocks/UnitValue.astro';

import { absoluteUrl, assetUrl, cartridgeHref, gunHref, href } from '../../lib/content/href.ts';
import { entryArticle } from '../../lib/render/json-ld.ts';
import type { CartridgeData } from '../../schemas/cartridge.ts';
import type { CompareCell } from '../../lib/compare/entry.ts';
import { CARTRIDGE_GROUP_ORDER, CARTRIDGE_REGISTRY } from '../../lib/compare/rows.ts';

export interface ChamberedIn {
  id: string;
  name: string;
  makerName?: string | null;
}

interface Props {
  cartridge: CartridgeData;
  /**
   * Every registry row's value, read by `lib/compare/entry.ts` — the same
   * function the gun page's spec table and the compare payload come through.
   */
  cells: Record<string, CompareCell>;
  /** Computed from `chamberings[].cartridgeRef`, never hand-maintained. */
  chamberedIn: ChamberedIn[];
}

const { cartridge, chamberedIn, cells } = Astro.props;
const identityOnly = cartridge.loads.length === 0;

const description = `${cartridge.name}: dimensions, pressure and load data transcribed from the published standard, plus every firearm chambered in it.`;

/** SPEC.md §12 — a cartridge entry is a `TechArticle`, not a listing. */
const jsonLd = entryArticle({
  type: 'TechArticle',
  name: cartridge.name,
  description,
  url: absoluteUrl(Astro.site, cartridgeHref(cartridge.id)),
  images: cartridge.images.map((image) => absoluteUrl(Astro.site, assetUrl(image.src))),
  dateModified: cartridge.lastVerified,
  about: [cartridge.name, ...cartridge.aliases.map((alias) => alias.name)],
  citation: cartridge.references.map((reference) =>
    [reference.title, reference.publisher, reference.year].filter(Boolean).join(', '),
  ),
});
---

<BaseLayout title={cartridge.name} description={description} jsonLd={jsonLd}>
  <div data-pagefind-body class="mx-auto max-w-(--layout-max) px-(--layout-gutter) py-6">
    <Breadcrumbs crumbs={[{ label: 'Cartridges', path: href('cartridges') }, { label: cartridge.name }]} />

    <header class="mt-4">
      <h1 class="type-display mt-2 text-display text-ink">{cartridge.name}</h1>
      {
        cartridge.nativeName && (
          <p class="type-title mt-1 text-xl text-ink-secondary" lang="und">
            {cartridge.nativeName}
          </p>
        )
      }
      <p class="type-data mt-3 flex flex-wrap gap-x-4 text-sm text-ink-secondary">
        {cartridge.introduced && <span>Introduced {cartridge.introduced}</span>}
        {cartridge.designedBy && <span>{cartridge.designedBy}</span>}
        {
          cartridge.standard !== 'none' && (
            <span class="uppercase tracking-wide text-ink-muted">
              {cartridge.standard.toUpperCase()} standard
            </span>
          )
        }
      </p>
      {
        cartridge.aliases.length > 0 && (
          <p class="type-data mt-2 max-w-note text-sm text-ink-muted">
            Also known as {cartridge.aliases.map((a) => a.name).join(', ')} — the same cartridge
            under different names, all of which find this page.
          </p>
        )
      }
    </header>

    <div class="prose type-body mt-6 max-w-lede text-lg text-ink-secondary">
      <slot name="lede" />
    </div>

    <Section
      id="dimensions"
      title="Dimensions and pressure"
      standfirst="Generated from the schema, like every specification table on this site, so a figure recorded on this entry cannot be missing from the table."
    >
      <SpecTable
        rows={CARTRIDGE_REGISTRY.rows}
        cells={cells}
        groupOrder={CARTRIDGE_GROUP_ORDER}
        idPrefix={`spec-${cartridge.id}`}
      />
      <p class="type-data mt-3 max-w-note text-xs text-ink-muted">
        SAAMI and C.I.P. measure pressure differently and their figures are not interchangeable,
        which is why the body is always named beside the figure.
      </p>
    </Section>

    {/* ── Loads ────────────────────────────────────────────────────────── */}
    <Section
      id="loads"
      title="Loads"
      standfirst={
        identityOnly
          ? undefined
          : 'Velocity is recorded per barrel length as published. A gun page interpolates between these points and never projects beyond them.'
      }
    >
      {
        identityOnly ? (
          <p class="type-data rounded-lg border border-dashed border-line-strong bg-surface-1 p-6 text-sm text-ink-muted">
            No load data recorded yet. Without a sourced bullet mass and velocity there is nothing
            honest to compute, so the ballistic figures on pages that chamber this cartridge stay
            blank rather than being estimated into existence.
          </p>
        ) : (
          <div class="flex flex-col gap-4">
            {cartridge.loads.map((load) => (
              <div class="rounded-lg border border-line bg-surface-1 p-4">
                <h3 class="type-heading text-base text-ink">{load.name}</h3>
                {load.manufacturer && (
                  <p class="type-data text-sm text-ink-muted">{load.manufacturer}</p>
                )}
                <dl class="mt-3 grid gap-x-6 sm:grid-cols-2">
                  <SpecRow label="Bullet mass" value={load.bulletMass} />
                  <SpecRow label="Cartridge mass" value={load.cartridgeMass} />
                  <SpecRow label="Bullet type" text={load.bulletType ?? null} />
                  <SpecRow label="G1 BC" value={load.bcG1} />
                  <SpecRow label="G7 BC" value={load.bcG7} />
                </dl>

                {load.velocityByBarrel.length > 0 && (
                  <div class="mt-4 overflow-x-auto">
                    <table class="type-data w-full min-w-[20rem] text-sm">
                      <caption class="type-data pb-2 text-left text-xs text-ink-muted">
                        Sourced velocity by barrel length
                      </caption>
                      <thead>
                        <tr class="border-b border-line-strong text-left text-ink-muted">
                          <th scope="col" class="p-2">Barrel</th>
                          <th scope="col" class="p-2">Velocity</th>
                        </tr>
                      </thead>
                      <tbody>
                        {load.velocityByBarrel.map((point) => (
                          <tr class="border-b border-line">
                            <td class="p-2 text-ink-secondary">
                              <UnitValue value={point.barrelLength.value} unit="mm" />
                            </td>
                            <td class="p-2 text-ink">
                              <UnitValue value={point.velocity.value} unit="m/s" />
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>
            ))}
          </div>
        )
      }
    </Section>

    {/* ── The computed half: this IS the caliber taxonomy view ─────────── */}
    <Section
      id="chambered-in"
      title="Chambered in"
      standfirst="Computed from every entry that lists this cartridge. Nothing here is hand-maintained."
    >
      {
        chamberedIn.length === 0 ? (
          <p class="type-data text-sm text-ink-muted">No entry on the site is chambered in it yet.</p>
        ) : (
          <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {chamberedIn.map((gun) => (
              <li class="rounded border border-line bg-surface-1 p-3">
                <a href={gunHref(gun.id)} class="type-data text-sm text-ui-accent">
                  {gun.name}
                </a>
                {gun.makerName && (
                  <p class="type-data text-xs text-ink-muted">{gun.makerName}</p>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </Section>

    {
      cartridge.images.length > 0 && (
        <Section id="gallery" title="Gallery">
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {cartridge.images.map((image, i) => (
              <ImageFigure image={image} id={`img-${cartridge.id}-${i}`} />
            ))}
          </div>
        </Section>
      )
    }

    {/*
      Narrative and bibliography share one row on a wide screen. The layout is
      88rem and a reading column is 41rem of it; stretching the prose to fill
      the rest would put 180 characters on a line, and leaving the rest empty
      is what made the page look broken. So the prose column IS the measure,
      and the references take every remaining pixel — they are the thing a
      reader most often wants next while reading a sourced claim, and long
      titles and publishers genuinely use the width. Below 1024px the two
      stack in the order they always had.
    */}
    <div
      class="mt-(--layout-section-gap) grid gap-(--layout-gutter) lg:grid-cols-[minmax(0,var(--measure-readable))_minmax(0,1fr)] lg:items-start"
    >
    <Section id="detail" title="Detail" flush>
      <div class="prose type-body max-w-readable text-ink-secondary">
        <slot />
      </div>
    </Section>

    <Section id="references" title="References" flush>
      <ol class="flex list-decimal flex-col gap-3 pl-5">
        {
          cartridge.references.map((reference) => (
            <li id={`ref-${reference.key}`} class="type-data text-sm text-ink-secondary">
              {reference.url ? (
                <a href={reference.url} rel="nofollow noopener" class="text-ui-accent">
                  {reference.title}
                </a>
              ) : (
                <span class="text-ink">{reference.title}</span>
              )}
              {reference.revision && <span> · {reference.revision}</span>}
              {reference.accessed && <span class="text-ink-muted"> · read {reference.accessed}</span>}
            </li>
          ))
        }
      </ol>
      <p class="type-data mt-4 text-xs text-ink-muted">
        Last verified {cartridge.lastVerified} · review status: {cartridge.reviewStatus}
      </p>
    </Section>
    </div>
  </div>
</BaseLayout>
