---
/**
 * An editorial article — the magazine half of ARMAG (SPEC.md §5.6).
 *
 * Long-form, each one linking twenty or more entries. The prose column is
 * narrower than a reference page's because this is text somebody reads several
 * paragraphs of rather than scans — `max-w-readable` is 76ch for exactly that
 * reason.
 */
import BaseLayout from '../ui/BaseLayout.astro';
import Breadcrumbs from '../blocks/Breadcrumbs.astro';
import ImageFigure from '../blocks/ImageFigure.astro';
import { absoluteUrl, articleHref, assetUrl, href } from '../../lib/content/href.ts';
import { entryArticle } from '../../lib/render/json-ld.ts';
import type { ImageRef } from '../../schemas/primitives.ts';

export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  id: string;
  title: string;
  standfirst: string;
  published: string;
  updated?: string;
  heroImage?: ImageRef;
  /** From `render()`, so the contents list is derived rather than typed. */
  headings?: Heading[];
}

const { id, title, standfirst, published, updated, heroImage, headings = [] } = Astro.props;

/** Only the top level: an h3 list turns the rail into a second article. */
const contents = headings.filter((heading) => heading.depth === 2);

/** SPEC.md §12 — editorial is `Article`; the spec entries are `TechArticle`. */
const jsonLd = entryArticle({
  type: 'Article',
  name: title,
  description: standfirst,
  url: absoluteUrl(Astro.site, articleHref(id)),
  images: heroImage ? [absoluteUrl(Astro.site, assetUrl(heroImage.src))] : undefined,
  datePublished: published,
  dateModified: updated ?? published,
});
---

<BaseLayout title={title} description={standfirst} jsonLd={jsonLd}>
  <div data-pagefind-body class="mx-auto max-w-(--layout-max) px-(--layout-gutter) py-6">
    <Breadcrumbs crumbs={[{ label: 'Articles', path: href('articles') }, { label: title }]} />

    <article class="mt-4">
      <header class="max-w-lede">
        <h1 class="type-display text-display text-ink">{title}</h1>
        <p class="type-body mt-4 text-lg text-ink-secondary">{standfirst}</p>
        <p class="type-data mt-3 text-sm text-ink-muted">
          <time datetime={published}>{published}</time>
          {updated && <span> · updated <time datetime={updated}>{updated}</time></span>}
        </p>
      </header>

      {
        heroImage && (
          <div class="mt-8">
            <ImageFigure image={heroImage} id={`img-hero-${id}`} priority />
          </div>
        )
      }

      {/*
        Prose and contents share one row on a wide screen. The prose column IS
        the reading measure — a long-form article is the one place on the site
        where stretching a line would be indefensible — and the contents take
        the rest, sticky, so the space beside the text does something instead
        of being empty.
      */}
      <div
        class="mt-8 grid gap-(--layout-gutter) lg:grid-cols-[minmax(0,var(--measure-readable))_minmax(0,1fr)] lg:items-start"
      >
        <div class="prose type-body text-ink-secondary">
          <slot />
        </div>

        {
          contents.length > 1 && (
            <nav aria-label="In this article" class="lg:sticky lg:top-20">
              <p class="type-heading text-xs uppercase tracking-widest text-ink-muted">
                In this article
              </p>
              <ol class="mt-3 flex flex-col gap-2">
                {contents.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="type-data text-sm text-ink-secondary hover:text-ui-accent"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </div>
    </article>
  </div>
</BaseLayout>
