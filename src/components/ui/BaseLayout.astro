---
/**
 * The document shell — every page on the site renders through this.
 *
 * A layout-less `.mdx` page emits no `<html>` and Pagefind skips it entirely,
 * so "every narrative page renders through a template" is not a style
 * preference: it is the condition on which the site is searchable at all.
 */
import Header from './Header.astro';
import JsonLd from '../blocks/JsonLd.astro';
import Footer from './Footer.astro';
import CompareTray from '../islands/CompareTray.svelte';
import { absoluteUrl, fileHref, href } from '../../lib/content/href.ts';
import type { JsonLdNode } from '../../lib/render/json-ld.ts';
import '../../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Kept out of the index and out of the sitemap. */
  noindex?: boolean;
  /** Canonical path, base included. Defaults to the current URL. */
  canonicalPath?: string;
  /**
   * Structured data for whatever this page is *about*. The
   * `BreadcrumbList` is not passed here: `Breadcrumbs.astro` emits its own from
   * the array it is already rendering, so the two cannot disagree.
   */
  jsonLd?: JsonLdNode | JsonLdNode[];
}

const { title, description, noindex = false, canonicalPath, jsonLd } = Astro.props;

const canonical = absoluteUrl(Astro.site, canonicalPath ?? Astro.url.pathname);
const fullTitle = title === 'ARMAG' ? 'ARMAG · Firearms reference' : `${title} · ARMAG`;

/** Site analytics. The measurement ID is public by design, and this is the only place it is written. */
const GA_ID = 'G-PDB2XDG2CH';

/*
 * The link-preview card, drawn by `npm run brand` from the site's own mark and
 * type. One card for every page: entry photographs carry attribution terms a
 * preview on another platform would drop.
 */
const ogImage = absoluteUrl(Astro.site, fileHref('og.png'));

/*
 * `theme-color` follows the theme the page actually resolved to. The observer
 * catches every writer of `data-theme` (the pre-paint script and the toggle)
 * without either knowing.
 */
const THEME_COLOR = { light: '#fbfcfd', dark: '#0a0c10', fallback: 'dark' };
const themeColorSync = `(()=>{const m=document.querySelector('meta[name="theme-color"]'),r=document.documentElement,c=${JSON.stringify(THEME_COLOR)},d=matchMedia('(prefers-color-scheme: dark)'),l=matchMedia('(prefers-color-scheme: light)'),s=()=>{const t=r.dataset.theme;m.content=c[t==='light'||t==='dark'?t:d.matches?'dark':l.matches?'light':c.fallback];};s();new MutationObserver(s).observe(r,{attributes:true,attributeFilter:['data-theme']});d.addEventListener('change',s);})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ARMAG" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ARMAG, a firearms reference" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/*
      `fileHref`, not `href`: a file is not a directory, and `href()` appends
      the trailing slash that `trailingSlash: 'always'` requires of a page. It
      shipped as `/ARMAG/favicon.svg/` on all 238 pages and nothing noticed —
      a 404 on a favicon is silent in the browser. Found by the internal-link
      assertion in `check:site`.
    */}
    <link rel="icon" href={fileHref('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={fileHref('apple-touch-icon.png')} />
    <link rel="manifest" href={fileHref('site.webmanifest')} />

    {jsonLd && <JsonLd node={jsonLd} />}

    {/*
      Runs before first paint, so a visitor who chose light does not see a
      frame of dark first. An explicit choice wins; without one the page
      follows the operating system, and dark remains what a visitor gets when
      the system states no preference at all.

      `is:inline` keeps it out of the bundle — a deferred module would run
      after paint, which is the whole failure this exists to prevent.
    */}
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('armag:theme');
          const units = localStorage.getItem('armag:units');
          if (units === 'imperial') document.documentElement.setAttribute('data-units', 'imperial');
        } catch {
          /* Storage can throw in a private window. The page still works; it just forgets. */
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <meta name="theme-color" content={THEME_COLOR.dark} />
    <script is:inline set:html={themeColorSync} />

    {
      import.meta.env.PROD && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          {/* The path only: a query string or hash can carry what a reader shared, and it stays theirs. */}
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',${JSON.stringify(GA_ID)},{page_location:location.origin+location.pathname});`}
          />
        </>
      )
    }
    <slot name="head" />
  </head>

  <body class="type-body flex min-h-dvh flex-col bg-surface-0 text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-surface-2 focus:px-4 focus:py-2 focus:text-ink"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    {/*
      Site-wide,, and `client:idle` because it must be
      listening for a Compare press on any page — including a press that
      happens before the reader has ever opened the tray. It renders nothing
      until there is something in it.
    */}
    <CompareTray client:idle comparePath={href('compare')} gunPrefix={href('guns')} />
  </body>
</html>
