---
/**
 * The site footer: one quiet row of links and the copyright, with one line of
 * small print underneath. The same shape on all four sites.
 *
 * The full disclaimer lives on the About page; the small print here is its
 * one-line form.
 */
import { href } from '../../lib/content/href.ts';

const links = [
  { label: 'About', path: href('about') },
  { label: 'Methodology', path: href('methodology') },
  { label: 'Editorial policy', path: href('editorial-policy') },
  { label: 'Attributions', path: href('attributions') },
  { label: 'Source code', path: 'https://github.com/kiarashfa/ARMAG' },
];

/*
 * The first year is fixed: it is when the project began. The current year is
 * read when the site is built, so every deploy carries the right range without
 * anyone editing it.
 */
const COPYRIGHT_START_YEAR = 2026;
const buildYear = new Date().getFullYear();
const years = buildYear > COPYRIGHT_START_YEAR ? `${COPYRIGHT_START_YEAR}–${buildYear}` : `${COPYRIGHT_START_YEAR}`;


const link = 'text-ink-secondary no-underline transition-colors hover:text-ui-accent';
---

<footer class="mt-(--layout-section-gap) border-t border-line" data-pagefind-ignore>
  <div class="type-data mx-auto max-w-(--layout-max) px-(--layout-gutter) pb-8 pt-5 text-[13px]">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <nav class="flex flex-wrap items-center gap-x-5 gap-y-1.5" aria-label="Site">
        <a class="type-title text-[15px] text-ink no-underline" href={href()}>ARMAG</a>
        <ul class="flex flex-wrap gap-x-4 gap-y-1.5">
          {links.map((l) => <li><a class={link} href={l.path}>{l.label}</a></li>)}
        </ul>
      </nav>
      <p class="text-ink-muted sm:ml-auto">© {years} Kiarash Farajzadehahary</p>
    </div>
    <p class="mt-3 text-xs leading-relaxed text-ink-muted">
      Reference information only: not legal advice, safety instruction, or a substitute for a manufacturer’s manual or qualified training.{' '}
      <a href={href('about')} class="text-ink-muted underline decoration-line underline-offset-2 hover:text-ink">Full disclaimer</a>.
    </p>
  </div>
</footer>
