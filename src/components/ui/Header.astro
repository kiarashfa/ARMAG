---
/**
 * Site header — the site's ONLY bar of controls.
 *
 * ── Why there is only one ─────────────────────────────────────────────────
 * There used to be two: this one, and a sticky per-entry bar on every gun page
 * carrying its own unit toggle. Two bars meant two Metric buttons on the same
 * screen doing the same thing, which is a bug however you look at it. The
 * global controls all live here now, this bar is sticky so they stay reachable
 * on a long page, and the per-entry actions moved into the entry itself
 * (`EntryActions.astro`), where the thing they act on is visible.
 *
 * The toggles are plain buttons with a few lines of inline script rather than
 * hydrated islands. A theme switch that needs 12 kB of framework to change one
 * attribute is a bad trade against SPEC.md §11's budget, and neither toggle has
 * state worth a component.
 *
 * The wordmark's mark is `public/favicon.svg` referenced as an image, not an
 * inline copy of the same paths: one file is the site's mark, and a second copy
 * pasted into the markup is the one that gets left behind when it changes.
 */
import Icon from '../blocks/Icon.astro';
import SiteSearch from '../islands/SiteSearch.svelte';
import { compareHref, fileHref, href } from '../../lib/content/href.ts';

const browse = [
  { label: 'Cartridges', path: href('cartridges') },
  { label: 'Manufacturers', path: href('makers') },
  { label: 'Glossary', path: href('glossary') },
  { label: 'Tools', path: href('tools') },
  { label: 'Armory', path: href('armory') },
];

/**
 * The section a page belongs to, so `/cartridges/9x19mm/` marks "Cartridges".
 * The home page is excluded because its path is a prefix of every page.
 */
const current = Astro.url.pathname;
const isCurrent = (path: string) => path !== href() && current.startsWith(path);

/*
 * Two control shapes, shared with the sibling sites: a 36px circle for a
 * control that is only an icon, and a pill of the same height for one that
 * also carries a word. On a phone the pill drops its word and becomes the
 * circle, so the row never changes height.
 */
const iconControl =
  'inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-line-strong text-ink-secondary no-underline transition-colors hover:bg-surface-2 hover:text-ink';
const pillControl =
  'type-data inline-flex h-9 shrink-0 items-center justify-center gap-1.5 rounded-full border border-line-strong text-sm text-ink-secondary no-underline transition-colors hover:bg-surface-2 hover:text-ink max-sm:w-9 sm:px-3';
---

<header
  class="sticky top-0 z-40 border-b border-line bg-surface-0/95 backdrop-blur"
  data-pagefind-ignore
>
  <div
    class="mx-auto flex max-w-(--layout-max) flex-wrap items-center gap-x-4 gap-y-2 px-(--layout-gutter) py-3.5 sm:gap-x-6"
  >
    <a href={href()} class="flex shrink-0 items-center gap-2.5 text-ink no-underline">
      <img src={fileHref('favicon.svg')} alt="" width="26" height="26" class="size-[26px] rounded" />
      <span class="type-title text-[1.4rem] leading-none tracking-tight">ARMAG</span>
    </a>

    <nav
      aria-label="Browse"
      class="type-data order-3 flex basis-full items-center gap-x-5 overflow-x-auto text-sm [scrollbar-width:none] sm:order-none sm:basis-auto sm:flex-wrap sm:gap-y-1 sm:overflow-visible"
    >
      {
        browse.map((item) => (
          <a
            href={item.path}
            aria-current={isCurrent(item.path) ? 'page' : undefined}
            class="group whitespace-nowrap py-1 text-ink-secondary no-underline transition-colors hover:text-ink aria-[current=page]:text-ink"
          >
            <span class="border-b border-transparent pb-[3px] transition-colors group-hover:border-ui-accent group-aria-[current=page]:border-ui-accent">
              {item.label}
            </span>
          </a>
        ))
      }
    </nav>

    {/*
      The controls, in the order every sibling site uses: this site's own
      (compare, units), then search, theme, about.
    */}
    <div class="ml-auto flex items-center gap-1.5 sm:gap-2">
      <a href={compareHref([])} class={pillControl} aria-label="Compare firearms side by side">
        <Icon name="compare" />
        <span class="hidden sm:inline">Compare</span>
      </a>

      <button
        type="button"
        data-unit-toggle
        class={pillControl}
        aria-label="Switch between metric and imperial units"
      >
        <Icon name="ruler" />
        <span class="hidden sm:inline">
          <span class="u-metric">Metric</span><span class="u-imperial" data-pagefind-ignore
            >Imperial</span
          >
        </span>
      </button>

      {/*
        `client:idle`, not `client:visible`: the overlay owns the `/` and Ctrl-K
        shortcuts, so it has to be listening even while its own button is
        off-screen. The Pagefind runtime itself still waits for the first open.
      */}
      <SiteSearch client:idle bundle={fileHref('pagefind/pagefind.js')} />

      {/*
        The icon shows what the button DOES, not what the page currently is:
        on a dark page it offers the sun. `global.css` swaps the pair on
        `[data-theme='light']`, so no script touches the icon and there is no
        frame in which the wrong one is showing.
      */}
      <button type="button" id="theme-toggle" class={iconControl} aria-label="Switch between the dark and light theme">
        <span class="theme-sun"><Icon name="sun" /></span>
        <span class="theme-moon"><Icon name="moon" /></span>
      </button>

      <a href={href('about')} class={iconControl} aria-label="About ARMAG">
        <Icon name="info" />
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const save = (key, value) => {
      try {
        localStorage.setItem(key, value);
      } catch {
        /* A private window can refuse. The toggle still works for this page. */
      }
    };

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      // The pre-paint script has already stamped the resolved theme. Storing the
      // choice is how it outlives the OS preference on the next visit.
      const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      save('armag:theme', next);
    });

    // `querySelectorAll`, not an id: a page may carry more than one unit
    // control, and two elements cannot share an id.
    for (const button of document.querySelectorAll('[data-unit-toggle]')) {
      button.addEventListener('click', () => {
        const next = root.getAttribute('data-units') === 'imperial' ? 'metric' : 'imperial';
        if (next === 'imperial') root.setAttribute('data-units', 'imperial');
        else root.removeAttribute('data-units');
        save('armag:units', next);
      });
    }
  })();
</script>
