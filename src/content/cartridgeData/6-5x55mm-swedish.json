  "images": [
    {
      "src": "images/cartridges/6-5x55mm-swedish/hero.webp",
      "alt": "A single 6.5x55mm Swedish cartridge photographed upright against a white background. The brass case is long and slender with a shallow shoulder, and carries a blunt round-nosed jacketed bullet.",
      "caption": "A 6.5x55mm Swedish round with a round-nose bullet of the original 1894 service pattern. The shoulder is shallow and the neck long, which is what lets the case seat a bullet of this length without intruding on powder space.",
      "width": 423,
      "height": 1600,
      "credit": {
