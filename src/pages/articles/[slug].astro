---
/** `/articles/<slug>/` — the magazine half. */
import ArticlePage from '../../components/templates/ArticlePage.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
// `headings` is what `render()` returns beside the component — the article's
// own h2/h3 tree, derived from the prose rather than typed beside it, so a
// renamed heading cannot leave a stale contents entry behind.
const { Content, headings } = await render(entry);
---

<ArticlePage
  id={entry.id}
  title={entry.data.title}
  standfirst={entry.data.standfirst}
  published={entry.data.published}
  updated={entry.data.updated}
  heroImage={entry.data.heroImage}
  headings={headings}
>
  <Content />
</ArticlePage>
