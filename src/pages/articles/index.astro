---
/** `/articles/` — editorial index. */
import BaseLayout from '../../components/ui/BaseLayout.astro';
import Breadcrumbs from '../../components/blocks/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { articleHref } from '../../lib/content/href.ts';

const articles = (await getCollection('articles')).sort((a, b) =>
  b.data.published.localeCompare(a.data.published),
);
---

<BaseLayout title="Articles" description="Long-form editorial from ARMAG.">
  <div class="mx-auto max-w-(--layout-max) px-(--layout-gutter) py-6">
    <Breadcrumbs crumbs={[{ label: 'Articles' }]} />
    <h1 class="type-display mt-4 text-display text-ink">Articles</h1>

    {
      articles.length === 0 ? (
        <p class="type-data mt-8 text-sm text-ink-muted">No articles published yet.</p>
      ) : (
        <ul class="mt-8 flex max-w-readable flex-col gap-6">
          {articles.map((article) => (
            <li>
              <h2 class="type-title text-lg">
                <a href={articleHref(article.id)} class="text-ui-accent">
                  {article.data.title}
                </a>
              </h2>
              <p class="type-body mt-1 text-sm text-ink-secondary">{article.data.standfirst}</p>
              <p class="type-data mt-1 text-xs text-ink-muted">{article.data.published}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
