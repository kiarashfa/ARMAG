---
/** `/makers/` — the manufacturer index. Every model list on these pages is computed. */
import BaseLayout from '../../components/ui/BaseLayout.astro';
import Breadcrumbs from '../../components/blocks/Breadcrumbs.astro';
import { getMakers } from '../../lib/content/entries.ts';
import { makerHref } from '../../lib/content/href.ts';
import { labelFor } from '../../schemas/taxonomy.ts';
import { humanise } from '../../lib/render/format.ts';

const makers = (await getMakers()).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout title="Manufacturers" description="Every manufacturer with an entry on ARMAG.">
  <div class="mx-auto max-w-(--layout-max) px-(--layout-gutter) py-6">
    <Breadcrumbs crumbs={[{ label: 'Makers' }]} />
    <h1 class="type-display mt-4 text-display text-ink">Manufacturers</h1>

    {
      makers.length === 0 ? (
        <p class="type-data mt-8 text-sm text-ink-muted">No manufacturers authored yet.</p>
      ) : (
        <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {makers.map((maker) => (
            <li class="rounded-lg border border-line bg-surface-1 p-3">
              <a href={makerHref(maker.id)} class="type-data text-sm text-ui-accent">
                {maker.data.name}
              </a>
              <p class="type-data text-xs text-ink-muted">
                {labelFor('country', maker.data.country) ?? humanise(maker.data.country)} · {maker.data.founded}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
