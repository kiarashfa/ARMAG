---
/** `/makers/` — the manufacturer index. Every model list on these pages is computed. */
import BaseLayout from '../../components/ui/BaseLayout.astro';
import { itemList } from '../../lib/render/json-ld.ts';
import Breadcrumbs from '../../components/blocks/Breadcrumbs.astro';
import MakerLogo from '../../components/blocks/MakerLogo.astro';
import { getMakers } from '../../lib/content/entries.ts';
import { absoluteUrl, makerHref } from '../../lib/content/href.ts';
import { labelFor } from '../../schemas/taxonomy.ts';
import { humanise } from '../../lib/render/format.ts';

const makers = (await getMakers()).sort((a, b) => a.data.name.localeCompare(b.data.name));

/** SPEC.md §12 — a browse view is an `ItemList`. */
const jsonLd = itemList(
  'Manufacturers on ARMAG',
  makers.map((maker) => ({
    name: maker.data.name,
    url: absoluteUrl(Astro.site, makerHref(maker.id)),
  })),
);
---

<BaseLayout
  title="Manufacturers"
  description="Every manufacturer with an entry on ARMAG."
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-(--layout-max) px-(--layout-gutter) py-6">
    <Breadcrumbs crumbs={[{ label: 'Makers' }]} />
    <h1 class="type-display mt-4 text-display text-ink">Manufacturers</h1>

    {
      makers.length === 0 ? (
        <p class="type-data mt-8 text-sm text-ink-muted">No manufacturers authored yet.</p>
      ) : (
        <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {makers.map((maker) => (
            <li class="flex items-center gap-3 rounded-lg border border-line bg-surface-1 p-3">
              <MakerLogo name={maker.data.name} logo={maker.data.logo} />
              <div class="min-w-0">
                <a href={makerHref(maker.id)} class="type-data text-sm text-ui-accent">
                  {maker.data.name}
                </a>
                <p class="type-data text-xs text-ink-muted">
                  {labelFor('country', maker.data.country) ?? humanise(maker.data.country)}
                  {/* `founded` is optional (Phase 10, item 196) — Sterling has none published. */}
                  {maker.data.founded && <span> · {maker.data.founded}</span>}
                </p>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
