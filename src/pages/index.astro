---
/**
 * Homepage — SPEC.md §11.1 and §16: spotlight plus catalogue for v1, with a
 * bespoke design later.
 *
 * The catalogue is rendered twice on purpose. `CatalogueStatic` is the real,
 * crawlable, JavaScript-free list; the island replaces it once hydrated and
 * adds the filters, the sort and the card view. Neither is a fallback for the
 * other in the usual sense — with JavaScript off, the static one *is* the
 * catalogue.
 */
import BaseLayout from '../components/ui/BaseLayout.astro';
import CatalogueStatic from '../components/blocks/CatalogueStatic.astro';
import Catalogue from '../components/islands/Catalogue.svelte';
import TypeBadge from '../components/blocks/TypeBadge.astro';

import { buildCatalogue, STATIC_ROW_COUNT } from '../lib/content/catalogue.ts';
import { getCartridges, getGuns, getMakers } from '../lib/content/entries.ts';
import { absoluteUrl, fileHref, gunHref, href, taxonomyHref } from '../lib/content/href.ts';
import { itemList } from '../lib/render/json-ld.ts';
import {
  actions,
  countries,
  eras,
  feedSystems,
  operatingSystems,
  roles,
  types,
} from '../schemas/taxonomy.ts';

const [guns, cartridges, makers] = await Promise.all([getGuns(), getCartridges(), getMakers()]);
const rows = buildCatalogue(guns, cartridges, makers);

/**
 * Vocabulary labels are passed *into* the island rather than imported by it.
 * That keeps the eight taxonomy JSON files out of the client bundle — they are
 * build-time data, and shipping them would be shipping the whole vocabulary to
 * render a dozen chips.
 */
const terms = (list: { terms: { id: string; label: string }[] }) =>
  list.terms.map((term) => ({ id: term.id, label: term.label }));

const vocab = {
  type: terms(types),
  action: terms(actions),
  operatingSystem: terms(operatingSystems),
  feed: terms(feedSystems),
  role: terms(roles),
  country: terms(countries),
  era: terms(eras),
};

/**
 * SPEC.md §12 — `ItemList` on the catalogue view. This page IS the catalogue
 * (SPEC.md §16), so the list is the whole row set rather than the first
 * screenful: a crawler that reads the structured data should see what a reader
 * who scrolls sees.
 *
 * A row below the publication floor carries no `url` (SPEC.md §5.9), which is
 * exactly what `itemList` does with a missing one — it is named, not linked.
 */
const catalogueJsonLd = itemList(
  'Firearms on ARMAG',
  rows.map((row) => ({
    name: row.name,
    url: row.hasPage ? absoluteUrl(Astro.site, gunHref(row.id)) : undefined,
  })),
);
---

<BaseLayout
  title="ARMAG"
  description="A free reference for modern firearms. Every number is either sourced or derived from sourced numbers by a formula you can open and check."
  jsonLd={catalogueJsonLd}
>
  <div class="mx-auto max-w-(--layout-max) px-(--layout-gutter) py-10">
    <h1 class="type-display text-display text-ink">ARMAG</h1>
    <p class="type-body mt-4 max-w-lede text-lg text-ink-secondary">
      A reference and magazine for firearms: one page per firearm, one per cartridge, one per
      manufacturer, joined by a lineage graph and driven by a real physics engine.
      <strong class="text-ink">
        Every number is either sourced or derived from sourced numbers by a formula you can open and
        check.</strong
      > There is no third category.
    </p>

    <nav aria-label="Browse by type" class="mt-8">
      <h2 class="type-heading text-xs uppercase tracking-widest text-ink-muted">Browse by type</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          types.terms.map((term) => (
            <li>
              <a href={taxonomyHref('type', term.id)} class="no-underline">
                <TypeBadge type={term.id} link={false} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        [
          { label: 'Cartridges', path: href('cartridges'), note: 'Each entry is also its caliber view.' },
          { label: 'Manufacturers', path: href('makers'), note: 'Model lists are computed, never typed.' },
          { label: 'Glossary', path: href('glossary'), note: 'Technical definitions, linked from every page.' },
        ].map((card) => (
          <a
            href={card.path}
            class="rounded-lg border border-line bg-surface-1 p-4 no-underline hover:border-line-strong"
          >
            <span class="type-heading text-base text-ui-accent">{card.label}</span>
            <span class="type-data mt-1 block text-sm text-ink-muted">{card.note}</span>
          </a>
        ))
      }
    </div>

    <section id="catalogue" class="mt-(--layout-section-gap) scroll-mt-16">
      <h2 class="type-title text-xl">
        <a href="#catalogue" class="text-ink no-underline hover:text-ui-accent">Catalogue</a>
      </h2>
      <p class="type-body mt-1 max-w-lede text-sm text-ink-secondary">
        Every entry in the database, including the ones too thin to have earned a page yet. Filters
        and sort order are kept in the address bar, so any view here is a link you can share.
      </p>

      <CatalogueStatic rows={rows.slice(0, STATIC_ROW_COUNT)} total={rows.length} />

      {/*
        `client:load`, not `client:visible`: the catalogue sits below the fold,
        and the island is what reads the filter state out of the URL. Waiting
        for it to scroll into view would mean a shared link showed the unfiltered
        list until the reader happened to scroll to it.
      */}
      <Catalogue
        client:load
        src={fileHref('catalogue.json')}
        gunPrefix={href('guns')}
        vocab={vocab}
        staticCount={Math.min(rows.length, STATIC_ROW_COUNT)}
      />
    </section>
  </div>
</BaseLayout>
