---
/**
 * Homepage: what ARMAG is, and the ways into it.
 *
 * It holds a fixed amount however large the database grows: the types to
 * browse by, a featured handful that changes weekly, and the doors to the full
 * catalogue at `/guns/`, the cartridges, the manufacturers and the glossary. It
 * used to carry the whole catalogue itself, which would have made it the
 * heaviest page on the site at a few thousand entries.
 */
import BaseLayout from '../components/ui/BaseLayout.astro';
import TypeBadge from '../components/blocks/TypeBadge.astro';
import { buildCatalogue } from '../lib/content/catalogue.ts';
import { getCartridges, getGuns, getMakers } from '../lib/content/entries.ts';
import { assetUrl, gunHref, href, taxonomyHref } from '../lib/content/href.ts';
import { srcsetFor } from '../lib/content/srcset.ts';
import { weeklyPick } from '../lib/showcase.ts';
import { types } from '../schemas/taxonomy.ts';

const [guns, cartridges, makers] = await Promise.all([getGuns(), getCartridges(), getMakers()]);
const rows = buildCatalogue(guns, cartridges, makers);
const rowsById = new Map(rows.map((row) => [row.id, row]));
const typeLabel = new Map(types.terms.map((t) => [t.id, t.label]));

/* Only entries with their own page and a photograph: a featured card that led
   to a thin row, or showed an empty frame, would be the first thing a visitor
   sees. */
const featured = weeklyPick(
  guns.filter((gun) => gun.data.images.length > 0 && rowsById.get(gun.id)?.hasPage),
  6,
).map((gun) => {
  const row = rowsById.get(gun.id)!;
  return {
    id: gun.id,
    name: gun.data.name,
    image: gun.data.images[0]!,
    type: row.type ? typeLabel.get(row.type) ?? row.type : null,
    maker: row.makerName,
    year: row.year,
  };
});

const doors = [
  { label: 'Firearms', path: href('guns'), note: `All ${rows.length} entries, filterable and sortable.` },
  { label: 'Cartridges', path: href('cartridges'), note: 'Each entry is also its caliber view.' },
  { label: 'Manufacturers', path: href('makers'), note: 'Model lists are computed, never typed.' },
  { label: 'Glossary', path: href('glossary'), note: 'Technical definitions, linked from every page.' },
];
---

<BaseLayout
  title="ARMAG"
  description="A free reference for modern firearms. Every number is either sourced or derived from sourced numbers by a formula you can open and check."
>
  <div class="mx-auto max-w-(--layout-max) px-(--layout-gutter) py-10">
    <h1 class="type-display text-display text-ink">ARMAG</h1>
    <p class="type-body mt-4 text-lg text-ink-secondary">
      A reference and magazine for firearms: one page per firearm, one per cartridge, one per
      manufacturer, joined by a lineage graph and driven by a real physics engine.{' '}
      <strong class="text-ink">
        Every number is either sourced or derived from sourced numbers by a formula you can open and
        check.</strong
      > There is no third category.
    </p>

    <nav aria-label="Browse by type" class="mt-8">
      <h2 class="type-heading text-xs uppercase tracking-widest text-ink-muted">Browse by type</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          types.terms.map((term) => (
            <li>
              <a href={taxonomyHref('type', term.id)} class="no-underline">
                <TypeBadge type={term.id} link={false} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      featured.length > 0 && (
        <section class="mt-(--layout-section-gap)" aria-labelledby="featured-title">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-line pb-3">
            <h2 id="featured-title" class="type-title text-xl">
              Featured this week
            </h2>
            <a href={href('guns')} class="type-data text-sm text-ink-secondary no-underline hover:text-ui-accent">
              All {rows.length} entries &rarr;
            </a>
          </div>
          <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {featured.map((entry) => (
              <li>
                <a
                  href={gunHref(entry.id)}
                  class="group flex h-full flex-col overflow-hidden rounded-lg border border-line bg-surface-1 no-underline transition-colors hover:border-line-strong"
                >
                  <span class="block aspect-[3/2] overflow-hidden bg-surface-2">
                    <img
                      src={assetUrl(entry.image.src)}
                      srcset={srcsetFor(assetUrl(entry.image.src), entry.image.width)}
                      sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 100vw"
                      alt={entry.image.alt}
                      width={entry.image.width}
                      height={entry.image.height}
                      loading="lazy"
                      decoding="async"
                      class={
                        (entry.image.width ?? 0) / (entry.image.height ?? 1) > 1.9
                          ? 'size-full object-contain p-3'
                          : 'size-full object-cover'
                      }
                    />
                  </span>
                  <span class="flex flex-1 flex-col p-4">
                    <span class="type-data text-xs uppercase tracking-widest text-ink-muted">
                      {[entry.type, entry.year].filter(Boolean).join(' · ')}
                    </span>
                    <span class="type-title mt-1 text-lg text-ink group-hover:text-ui-accent">{entry.name}</span>
                    {entry.maker && <span class="type-data mt-1 text-sm text-ink-secondary">{entry.maker}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-(--layout-section-gap)" aria-label="Ways in">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          doors.map((door) => (
            <a
              href={door.path}
              class="rounded-lg border border-line bg-surface-1 p-4 no-underline hover:border-line-strong"
            >
              <span class="type-heading text-base text-ui-accent">{door.label}</span>
              <span class="type-data mt-1 block text-sm text-ink-muted">{door.note}</span>
            </a>
          ))
        }
      </div>
    </section>

    <div class="mt-10 flex justify-center">
      <a
        href={href('guns')}
        class="type-data inline-flex items-center gap-2 rounded-full border border-line-strong px-5 py-2.5 text-sm text-ink no-underline hover:bg-surface-2"
      >
        Open the catalogue <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</BaseLayout>
