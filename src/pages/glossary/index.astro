---
/**
 * `/glossary/` — SPEC.md §5.6. Every term here is auto-crosslinked from every
 * occurrence in any prose on the site by a rehype plugin (Phase 11), so link
 * density needs no manual upkeep and survives renames.
 */
import BaseLayout from '../../components/ui/BaseLayout.astro';
import { itemList } from '../../lib/render/json-ld.ts';
import Breadcrumbs from '../../components/blocks/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { absoluteUrl, glossaryHref } from '../../lib/content/href.ts';

const terms = (await getCollection('glossary')).sort((a, b) =>
  a.data.term.localeCompare(b.data.term),
);

/** SPEC.md §12 — a browse view is an `ItemList`. */
const jsonLd = itemList(
  'ARMAG glossary',
  terms.map((entry) => ({
    name: entry.data.term,
    url: absoluteUrl(Astro.site, glossaryHref(entry.id)),
  })),
);
---

<BaseLayout
  jsonLd={jsonLd}
  title="Glossary"
  description="The vocabulary of firearms, defined technically. Every term is linked automatically from every page that uses it."
>
  <div class="mx-auto max-w-(--layout-max) px-(--layout-gutter) py-6">
    <Breadcrumbs crumbs={[{ label: 'Glossary' }]} />
    <h1 class="type-display mt-4 text-display text-ink">Glossary</h1>
    <p class="type-body mt-3 max-w-lede text-lg text-ink-secondary">
      Definitions here are technical rather than colloquial. Where a term is argued over, the entry
      states the definition it uses and why, instead of picking a side quietly.
    </p>

    {
      terms.length === 0 ? (
        <p class="type-data mt-8 text-sm text-ink-muted">No terms authored yet.</p>
      ) : (
        <dl class="mt-8 max-w-readable">
          {terms.map((entry) => (
            <div class="border-b border-line py-3">
              <dt class="type-heading text-base">
                <a href={glossaryHref(entry.id)} class="text-ui-accent">
                  {entry.data.term}
                </a>
              </dt>
              <dd class="type-data mt-1 text-sm text-ink-secondary">{entry.data.short}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</BaseLayout>
